# Base de données PostgreSQL, hébergement UE (garde-fou n° 5).
# La V2 utilise une base DÉDIÉE et vierge : son schéma est incompatible avec
# celui de la V1, et la migration initiale ne supprime rien.
DATABASE_URL="postgresql://user:password@host:5432/nexteo"
# Connexion directe, réservée aux migrations : un pooler ne sait pas les jouer.
DIRECT_URL="postgresql://user:password@host:5432/nexteo"

# --- Source des annonces -----------------------------------------------------
# `fixture` lit des annonces de test depuis /fixtures. C'est le mode par défaut,
# et il le reste tant que la vérification d'identité et la revue d'application
# n'ont pas abouti chez Meta : tout le produit se développe et se teste dessus.
# `meta` interroge l'API officielle Ad Library.
AD_SOURCE="fixture"
META_ACCESS_TOKEN=""
# Pays de l'UE ingérés, dans l'ordre. `ad_reached_countries` est obligatoire
# dans chaque requête : il n'existe aucune requête mondiale.
META_COUNTRIES="FR,BE,ES,IT,DE,NL"
# Termes suivis, séparés par des virgules. 100 caractères maximum par terme.
META_SEARCH_TERMS="saas,logiciel,application,abonnement,essai gratuit"
# Jeton protégeant /api/ingestion, appelé par le planificateur.
INGESTION_TOKEN=""

# --- Stockage objet des visuels ---------------------------------------------
# Les URL renvoyées par Meta expirent : les visuels sont copiés à l'ingestion.
# Sans configuration, le pipeline tourne et note les visuels comme non copiés.
S3_ENDPOINT=""
S3_REGION="eu-west-3"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Auth.js v5 --------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Stripe ------------------------------------------------------------------
# Le webhook est le SEUL octroi d'un accès payant. Sans clé, l'écran des tarifs
# le dit franchement plutôt que d'ouvrir un accès.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_MONTHLY=""
STRIPE_PRO_ANNUAL=""
STRIPE_PRO_PLUS_MONTHLY=""
STRIPE_PRO_PLUS_ANNUAL=""
STRIPE_AGENCY_MONTHLY=""
STRIPE_AGENCY_ANNUAL=""

# --- E-mails -----------------------------------------------------------------
AUTH_RESEND_KEY=""
EMAIL_FROM="Nexteo <bonjour@nexteo.app>"
NEXT_PUBLIC_SUPPORT_EMAIL="bonjour@nexteo.app"

# --- Administration ----------------------------------------------------------
ADMIN_EMAILS=""

# Base dédiée aux tests d'intégration du pipeline. Les suites concernées se
# sautent d'elles-mêmes quand elle n'est pas joignable.
TEST_DATABASE_URL=""
