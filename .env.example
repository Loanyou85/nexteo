# ─── Base de données (PostgreSQL, hébergement UE) ──────────────────────────
# Une base VIERGE : le script de préparation refuse de poser ce schéma sur la
# base d'un ancien produit.
DATABASE_URL=""          # chaîne « poolée » (avec pooler) pour l'application
DIRECT_URL=""            # chaîne directe (SANS pooler) pour les migrations

# ─── Authentification (Auth.js v5) ─────────────────────────────────────────
AUTH_SECRET=""           # openssl rand -base64 32
AUTH_URL=""              # https://nexteo.app
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""        # facultatif
AUTH_GOOGLE_SECRET=""    # facultatif
ADMIN_EMAILS=""          # adresses promues administrateur, séparées par des virgules

# ─── IA ─────────────────────────────────────────────────────────────────────
# Sans clé, l'IA simulée prend le relais et une bannière l'annonce partout.
ANTHROPIC_API_KEY=""
AI_PROVIDER=""           # « simule » pour forcer l'IA simulée même avec une clé

# ─── UEFN ──────────────────────────────────────────────────────────────────
# « mock » tant que l'agent local et le vrai MCP ne sont pas branchés (phase F).
UEFN_PROVIDER="mock"

# ─── Worker ────────────────────────────────────────────────────────────────
# Laisser vide sur Vercel : les générations simulées avancent depuis la console.
WORKER_ID=""

# ─── Stripe ────────────────────────────────────────────────────────────────
# Les identifiants de prix se génèrent avec : npx tsx scripts/stripe-setup.ts
# (mode test uniquement). Les recharges n'ont pas de prix fixe : quantité libre.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CREATOR_MONTHLY=""
STRIPE_CREATOR_ANNUAL=""
STRIPE_PRO_MONTHLY=""
STRIPE_PRO_ANNUAL=""
STRIPE_STUDIO_MONTHLY=""
STRIPE_STUDIO_ANNUAL=""

# ─── Tâche quotidienne (versement mensuel des abonnés annuels) ─────────────
CRON_SECRET=""           # Vercel l'envoie en en-tête Authorization
