// Nexteo — génération de jeux UEFN par agent autonome.
//
// Trois familles de tables, qu'il ne faut pas confondre :
//
// - l'INTENTION : Project, GameSpec (versionné), BuildPlan, BuildTask. Ce que
//   l'utilisateur veut et ce que l'orchestrateur a prévu de faire.
// - l'ÉTAT OBSERVÉ : VerseFile, DeviceInstance, SceneEntity. Un reflet du
//   projet UEFN tel qu'il a été relu à la dernière inspection — jamais la
//   source de vérité. La boucle d'agent relit le vrai projet avant d'agir.
// - la TRACE : AgentEvent, UsageEvent, BuildError, TestResult. Ce qui s'est
//   réellement passé, conservé tel quel, y compris les messages bruts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Comptes ────────────────────────────────────────────────────────────────

enum Role {
  user
  admin
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  name              String?
  image             String?
  passwordHash      String?
  role              Role      @default(user)
  consentAcceptedAt DateTime?
  consentVersion    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  usageEvents  UsageEvent[]
  usage        UsageCounter[]
  credits      CreditLedger[]
  projects     Project[]
  localAgents  LocalAgent[]
  pairingCodes PairingCode[]
  apiKeys      ApiKey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Offres, crédits, coûts ────────────────────────────────────────────────
//
// Aucun prix, aucun quota, aucune remise en dur : tout vit ici et se modifie
// depuis l'administration, sans déploiement. Tous les montants sont en
// centimes entiers — jamais de flottant pour de l'argent.

/// Une offre. « Découverte » est une ligne comme les autres, à 0 €.
model Plan {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  tagline              String
  monthlyPriceCents    Int
  /// Nul : pas de facturation annuelle pour cette offre.
  annualPriceCents     Int?
  monthlyCredits       Int
  /// Plans de jeu par mois ; nul = illimité.
  monthlyGamePlans     Int?
  /// Projets actifs ; nul = illimité.
  maxProjects          Int?
  maxMembers           Int      @default(1)
  /// Durée de conservation des versions ; nul = illimitée.
  versionHistoryDays   Int?
  /// Plus c'est haut, plus la file de build passe devant.
  queuePriority        Int      @default(0)
  /// Faux pour Découverte : un build gratuit serait la première source de perte.
  realBuilds           Boolean
  /// « 2 jeux, ou 1 jeu + 5 mises à jour ».
  equivalent           String
  /// Liste de { label, available } : une fonctionnalité pas encore construite
  /// est affichée « bientôt », jamais vendue comme disponible.
  features             Json
  /// Identifiants de prix Stripe. Renseignés par le script de création ou par
  /// l'administration ; à défaut, lus dans les variables d'environnement.
  stripeMonthlyPriceId String?
  stripeAnnualPriceId  String?
  isHighlighted        Boolean  @default(false)
  sortOrder            Int
  isActive             Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  budget        BuildBudget?
  subscriptions Subscription[]
  changes       PlanChange[]
}

/// Historique des modifications d'une offre en administration.
model PlanChange {
  id        String   @id @default(cuid())
  planId    String
  actorId   String
  field     String
  before    Json
  after     Json
  createdAt DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}

/// Budgets d'un build, par offre (section 26 du cahier principal).
model BuildBudget {
  planId             String @id
  maxAgentSteps      Int    @default(150)
  maxRetries         Int    @default(5)
  maxBuildMinutes    Int    @default(60)
  maxPlaytestMinutes Int    @default(15)
  /// Plafond de crédits d'un build : c'est lui qui est réservé au lancement.
  maxCreditsPerBuild Int

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

/// Réglages chiffrés : COST_PER_CREDIT, MAX_ANNUAL_DISCOUNT, ROLLOVER_MONTHS…
/// Valeurs entières stockées en texte, lues par un accès typé.
model PricingConfig {
  key         String   @id
  value       String
  description String
  updatedAt   DateTime @updatedAt
}

enum BillingInterval {
  month
  year
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

/// Un utilisateur sans ligne ici est en Découverte.
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planId               String
  interval             BillingInterval    @default(month)
  status               SubscriptionStatus @default(incomplete)
  /// Tarif figé à la souscription : un changement de prix ne touche jamais
  /// les abonnés en cours.
  priceCents           Int
  stripePriceId        String?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  /// Prochain versement de crédits. Pour l'annuel, chaque mois à la date
  /// anniversaire — jamais douze mois d'un bloc.
  nextCreditGrantAt    DateTime?
  /// Descente de plan ou passage au mensuel programmés à l'échéance.
  pendingPlanId        String?
  pendingInterval      BillingInterval?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

enum CreditBucket {
  subscription
  rollover
  topup
}

enum CreditReason {
  grant
  reserve
  release
  debit
  refund
  expire
  adjust
}

/// Registre des crédits, en ajout seul : aucune mise à jour, aucune
/// suppression (un déclencheur l'interdit en base). Le solde se calcule à
/// partir d'ici ; il peut être mis en cache, le registre fait foi.
model CreditLedger {
  id             String       @id @default(cuid())
  userId         String
  delta          Int
  bucket         CreditBucket
  reason         CreditReason
  /// La génération (AgentSession) concernée.
  buildId        String?
  stripeEventId  String?
  /// Rend chaque écriture rejouable sans effet : un webhook reçu deux fois,
  /// une tâche relancée le même jour, ne versent jamais deux fois.
  idempotencyKey String?      @unique
  expiresAt      DateTime?
  /// Motif — obligatoire pour un ajustement manuel.
  note           String?
  actorId        String?
  /// Écriture due à une génération simulée : exclue des mesures de coût réel.
  simulated      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([buildId])
}

/// Événements Stripe déjà traités : c'est ce qui rend le webhook idempotent.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Un appel LLM = une ligne. Sans cette mesure, impossible de fixer les prix.
model UsageEvent {
  id               String   @id @default(cuid())
  userId           String
  projectId        String?
  buildId          String?
  type             String
  provider         String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  /// Coût en millionièmes d'euro, entier. Un appel coûte souvent moins d'un
  /// centime : en centimes entiers, la plupart vaudraient zéro et la somme
  /// serait fausse. On arrondit au centime à l'affichage seulement.
  costEurMicros    Int
  /// Vrai quand l'IA simulée a répondu : coût estimé, pas mesuré. Exclu des
  /// moyennes de coût réel de l'administration.
  simulated        Boolean
  createdAt        DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  build   AgentSession? @relation(fields: [buildId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([buildId])
  @@index([createdAt])
}

model UsageCounter {
  id     String @id @default(cuid())
  userId String
  /// Période au format « 2026-09 ».
  period String
  builds Int    @default(0)
  plans  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  /// Empreinte de la clé ; la clé elle-même n'est montrée qu'une fois.
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Référentiels éditables en administration ──────────────────────────────

/// Les templates sont des données (section 7) : en ajouter un ne demande
/// aucun déploiement.
model GameTemplate {
  id           String   @id
  name         String
  genre        String
  pitch        String
  /// GameSpec de départ, validé par le schéma Zod à la lecture.
  baseSpec     Json
  /// Modules Verse attendus, dans l'ordre de construction.
  verseModules String[]
  /// Pièges connus, affichés à l'utilisateur et fournis à l'IA.
  pitfalls     String[]
  /// Seul le scénario de référence est activé tant qu'il n'est pas fiable
  /// dix fois de suite (section 33).
  enabled      Boolean  @default(false)
  sortOrder    Int
  updatedAt    DateTime @updatedAt
}

model EnvironmentTemplate {
  id          String   @id
  name        String
  description String
  /// Zones, points d'intérêt, aires d'apparition, ancres de gameplay.
  layout      Json
  updatedAt   DateTime @updatedAt
}

/// Registre des devices (section 13). L'IA ne choisit que parmi ces lignes.
model DeviceDefinition {
  deviceType             String    @id
  displayName            String
  capabilities           String[]
  configurableProperties Json
  dependencies           String[]
  knownConstraints       String[]
  supportedGameTypes     String[]
  /// Dernière confrontation au catalogue réel. Nul = jamais vérifié contre
  /// le vrai MCP : le device ne vient que du catalogue simulé.
  verifiedAt             DateTime?
  /// Source de la dernière vérification : « mock » ou « mcp ».
  verifiedBy             String?
  updatedAt              DateTime  @updatedAt
}

/// Correspondance besoin du GameSpec → device, éditable (pas de chaîne de if).
model DeviceMapping {
  need        String   @id
  deviceType  String
  defaults    Json
  description String
  updatedAt   DateTime @updatedAt
}

// ─── Projets et intention ──────────────────────────────────────────────────

enum ProviderKind {
  mock
  mcp
}

model Project {
  id                  String       @id @default(cuid())
  userId              String
  name                String
  genre               String
  templateId          String?
  /// Palier de rareté 1 à 5 (section 4.1), recalculé depuis les faits.
  tier                Int          @default(1)
  currentSpecVersion  Int          @default(0)
  provider            ProviderKind @default(mock)
  /// Niveau d'autorisation 1 à 5 (section 20).
  permissionLevel     Int          @default(4)
  /// Le niveau 5 exige une confirmation explicite, datée, par projet.
  autonomyConfirmedAt DateTime?
  /// Verrou d'exécution : un seul exécutant par projet, jamais d'appels
  /// UEFN en parallèle (section 2.3).
  leaseOwner          String?
  leaseUntil          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  specs       GameSpec[]
  versions    ProjectVersion[]
  plans       BuildPlan[]
  sessions    AgentSession[]
  verseFiles  VerseFile[]
  devices     DeviceInstance[]
  entities    SceneEntity[]
  testSpecs   TestSpec[]
  errors      BuildError[]
  prePublish  PrePublishCheck[]
  usageEvents UsageEvent[]
  simulation  SimulationState?

  @@index([userId, updatedAt])
}

/// Une ligne par version : chaque modification crée une nouvelle version,
/// comparable et restaurable (section 6).
model GameSpec {
  id          String   @id @default(cuid())
  projectId   String
  version     Int
  specVersion String
  data        Json
  /// « ia », « utilisateur » ou « restauration ».
  author      String
  note        String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
}

/// Photographie d'un projet après une génération (section 21).
model ProjectVersion {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  specVersion Int
  sessionId   String?  @unique
  summary     String
  tier        Int
  /// Fichiers Verse, devices et entités relus à la fin de la génération.
  snapshot    Json
  createdAt   DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
}

model BuildPlan {
  id          String   @id @default(cuid())
  projectId   String
  specVersion Int
  /// « initial » pour une première construction, « mise-a-jour » ensuite.
  kind        String
  request     String?
  createdAt   DateTime @default(now())

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks    BuildTask[]
  sessions AgentSession[]
}

enum TaskStatus {
  pending
  running
  verifying
  done
  failed
  skipped
}

model BuildTask {
  id            String     @id @default(cuid())
  planId        String
  /// Identifiant stable dans le plan, dérivé du GameSpec : c'est lui qui rend
  /// la reprise idempotente.
  key           String
  type          String
  description   String
  dependsOn     String[]
  status        TaskStatus @default(pending)
  attempt       Int        @default(0)
  maxAttempts   Int        @default(3)
  order         Int
  input         Json
  result        Json?
  error         Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  tokensUsed    Int        @default(0)
  costEurMicros Int        @default(0)

  plan BuildPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId, status])
}

// ─── Exécution ──────────────────────────────────────────────────────────────

enum SessionStatus {
  queued
  running
  paused
  stopping
  stopped
  awaiting_human
  completed
  failed
}

/// Une génération. C'est elle que la console affiche.
model AgentSession {
  id               String        @id @default(cuid())
  projectId        String
  planId           String
  status           SessionStatus @default(queued)
  provider         ProviderKind
  /// Commande humaine en attente, appliquée entre deux tâches : un Stop
  /// n'interrompt jamais une écriture en cours (section 20).
  pendingCommand   String?
  /// Raison d'un arrêt : budget atteint, intervention demandée, erreur.
  stopReason       String?
  steps            Int           @default(0)
  retries          Int           @default(0)
  tokensUsed       Int           @default(0)
  costEurMicros    Int           @default(0)
  /// Estimation annoncée avant lancement, plafond réservé, débit final.
  creditsEstimated Int           @default(0)
  creditsReserved  Int           @default(0)
  creditsDebited   Int?
  /// Échec imputable à la plateforme : crédits restitués.
  refunded         Boolean       @default(false)
  /// Étapes et minutes accordées en plus du budget, après confirmation
  /// explicite de continuer (règle 4 de l'offre).
  stepsAllowance   Int           @default(0)
  minutesAllowance Int           @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  lastHeartbeat    DateTime?
  createdAt        DateTime      @default(now())

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan        BuildPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  events      AgentEvent[]
  usageEvents UsageEvent[]
  testRuns    TestRun[]
  errors      BuildError[]
  version     ProjectVersion?

  @@index([projectId, createdAt])
  @@index([status])
}

/// Alimente la console temps réel. Grossit vite : purge des sessions
/// anciennes prévue, et `seq` sert de curseur au flux SSE (Last-Event-ID).
model AgentEvent {
  seq       BigInt   @id @default(autoincrement())
  sessionId String
  projectId String
  type      String
  level     String   @default("info")
  taskKey   String?
  message   String
  data      Json?
  createdAt DateTime @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, seq])
  @@index([sessionId, createdAt])
  @@index([createdAt])
}

/// Poste local de l'utilisateur (section 9). Le jeton est révocable.
model LocalAgent {
  id          String    @id @default(cuid())
  userId      String
  machineName String
  machineId   String
  version     String?
  tokenHash   String    @unique
  lastSeenAt  DateTime?
  /// Derniers résultats de vérification des prérequis (section 2.2).
  diagnostics Json?
  /// Catalogue d'outils MCP tel que l'éditeur l'a annoncé (`tools/list`), avec
  /// la date de découverte. C'est la SEULE source des noms d'outils réels.
  catalogue   Json?
  catalogueAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  commandes AgentCommand[]

  @@unique([userId, machineId])
}

/// Battement du worker : si personne ne tourne, la console le dit au lieu
/// d'afficher une attente sans fin.
model WorkerHeartbeat {
  id        String   @id
  host      String
  version   String
  seenAt    DateTime
  startedAt DateTime
}

// ─── État observé du projet UEFN ───────────────────────────────────────────

model VerseFile {
  id          String   @id @default(cuid())
  projectId   String
  path        String
  content     String
  contentHash String
  module      String?
  observedAt  DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model DeviceInstance {
  id          String   @id @default(cuid())
  projectId   String
  /// Identifiant dérivé du GameSpec, posé en étiquette dans UEFN : c'est ce
  /// qui permet de vérifier l'existence avant de recréer.
  stableId    String
  uefnId      String?
  deviceType  String
  label       String
  /// Position en Left-Up-Forward, jamais en XYZ (section 2.3).
  positionLuf Json
  properties  Json
  observedAt  DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stableId])
}

model SceneEntity {
  id           String   @id @default(cuid())
  projectId    String
  stableId     String
  uefnId       String?
  name         String
  components   Json
  transformLuf Json
  observedAt   DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, stableId])
}

/// État du projet UEFN simulé. N'existe que pour le fournisseur simulé ;
/// persisté en base pour que la reprise après interruption soit testable.
model SimulationState {
  projectId String   @id
  state     Json
  /// Compteur d'opérations : graine des pannes déterministes.
  opCounter Int      @default(0)
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Tests, erreurs, pré-publication ───────────────────────────────────────

enum Severity {
  blocking
  warning
}

/// Générés depuis le GameSpec, jamais écrits à la main (section 17).
model TestSpec {
  id          String   @id @default(cuid())
  projectId   String
  specVersion Int
  key         String
  description String
  trigger     String
  assertion   String
  expected    String
  severity    Severity

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results TestResult[]

  @@unique([projectId, specVersion, key])
}

model TestRun {
  id         String    @id @default(cuid())
  sessionId  String
  attempt    Int
  startedAt  DateTime
  finishedAt DateTime?
  passed     Int       @default(0)
  failed     Int       @default(0)
  logCount   Int       @default(0)

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results TestResult[]
}

model TestResult {
  id         String   @id @default(cuid())
  runId      String
  testSpecId String
  passed     Boolean
  observed   String
  /// Lignes de log sur lesquelles le verdict s'appuie.
  evidence   String[]

  run  TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  spec TestSpec @relation(fields: [testSpecId], references: [id], onDelete: Cascade)
}

enum ErrorCategory {
  compile_error
  verse_error
  device_error
  missing_asset
  invalid_reference
  runtime_error
  gameplay_error
  performance_issue
  memory_issue
  mcp_timeout
  editor_hang
}

enum FixStatus {
  proposed
  applied
  verified
  failed
}

/// Nommée BuildError et non Error : une table Error produirait un type
/// Prisma qui masquerait l'Error native de JavaScript dans tout le code.
model BuildError {
  id           String        @id @default(cuid())
  projectId    String
  sessionId    String?
  category     ErrorCategory
  severity     Severity
  /// Fichier, ligne, device ou entité en cause.
  source       Json
  /// Le message brut, toujours conservé : une erreur reformulée sans le
  /// texte d'origine est indébogable (section 19).
  raw          String
  evidence     String[]
  suggestedFix String?
  fixStatus    FixStatus?
  attempt      Int           @default(1)
  createdAt    DateTime      @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([sessionId])
}

model PrePublishCheck {
  id        String   @id @default(cuid())
  projectId String
  sessionId String?
  ready     Boolean
  /// Chaque contrôle : clé, libellé, verdict, détail, lien.
  checks    Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// Code d'appairage à usage unique : l'utilisateur le saisit dans l'agent, qui
/// l'échange contre un jeton. Seul le hachage est stocké.
model PairingCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Ordre envoyé à l'agent local. L'agent vient le chercher (long-poll) : un
/// site sur Vercel ne peut pas garder de connexion ouverte vers un PC.
model AgentCommand {
  id        String    @id @default(cuid())
  agentId   String
  method    String
  params    Json
  /// pending → taken → done | failed
  status    String    @default("pending")
  result    Json?
  error     String?
  createdAt DateTime  @default(now())
  takenAt   DateTime?
  doneAt    DateTime?
  expiresAt DateTime

  agent LocalAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status, createdAt])
