// Nexteo — schéma de données (section 7 du prompt maître).
//
// Trois règles structurantes.
//
//   1. Aucun champ ne porte, ne dérive ni n'approche un montant attribué à une
//      entreprise tierce. Pas de revenu, pas de MRR, pas de « taille estimée ».
//      Si un champ ajouté ici ressemble à de l'argent, il ne doit pas exister.
//
//   2. Les poids du signal vivent en base (SignalWeight), jamais dans le code :
//      les régler ne doit pas demander un déploiement.
//
//   3. AdObservation ne se met jamais à jour. On empile des observations
//      horodatées, une par annonce et par exécution, même quand rien n'a
//      changé. C'est cette table qui porte la valeur du produit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Connexion applicative : passe par le pooler de l'hébergeur en production.
  url       = env("DATABASE_URL")
  // Connexion directe, réservée aux migrations : un pooler ne sait pas
  // exécuter les instructions de migration. En local, identique.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Comptes
// ---------------------------------------------------------------------------

enum Role {
  user
  admin
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  /// Empreinte scrypt. Absente pour un compte créé via Google.
  passwordHash  String?
  image         String?
  role          Role      @default(user)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // RGPD : consentement explicite, conservation documentée.
  consentAcceptedAt   DateTime?
  consentVersion      String?
  dataRetentionMonths Int       @default(36)

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  usage        UsageCounter[]
  collections  Collection[]
  savedItems   SavedItem[]
  savedSearch  SavedSearch[]
  watches      Watch[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

enum Plan {
  free
  pro
  pro_plus
  agency
}

enum BillingInterval {
  monthly
  annual
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(free)
  interval             BillingInterval    @default(monthly)
  status               SubscriptionStatus @default(active)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Compteur de quota mensuel.
///
/// Le gratuit fonctionne **sans compte** : trois fiches complètes par mois.
/// Il faut donc pouvoir compter un visiteur anonyme, identifié par un cookie.
/// Exactement l'une des deux colonnes d'identité est renseignée. Postgres
/// traite les NULL comme distincts dans un index unique, donc les deux
/// contraintes ci-dessous ne contraignent chacune que les lignes concernées.
model UsageCounter {
  id           String  @id @default(cuid())
  userId       String?
  /// Identifiant de cookie, pour un visiteur sans compte.
  visitorId    String?
  /// Période au format « 2026-09 ».
  period       String
  searches     Int     @default(0)
  profileViews Int     @default(0)
  exports      Int     @default(0)

  /// Annonceurs déjà consultés ce mois-ci.
  ///
  /// Revoir une fiche déjà ouverte ne doit rien coûter : recharger une page ou
  /// revenir en arrière n'est pas une nouvelle consultation, et facturer un
  /// aller-retour serait un piège plutôt qu'un quota. La liste reste courte —
  /// trois entrées sur l'offre gratuite, et les offres payantes ne comptent pas.
  viewedProfiles String[]

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@unique([visitorId, period])
}

// ---------------------------------------------------------------------------
// Annonceurs et annonces
// ---------------------------------------------------------------------------

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  label    String
  parentId String?
  parent   Category?  @relation("SousCategories", fields: [parentId], references: [id])
  children Category[] @relation("SousCategories")

  advertisers Advertiser[]
}

model Advertiser {
  id          String  @id @default(cuid())
  metaPageId  String  @unique
  slug        String  @unique
  name        String
  websiteUrl  String?
  categoryId  String?
  /// Pays où l'annonceur est le plus observé. Descriptif, jamais un siège social.
  countryCode String?

  firstSeenAt DateTime
  lastSeenAt  DateTime

  /// 0 à 100. Activité publicitaire observée. Jamais une santé financière.
  signalScore      Int       @default(0)
  /// Détail du calcul, affiché tel quel sur la fiche. Un score opaque serait
  /// indéfendable puisque c'est le cœur du produit.
  signalBreakdown  Json?
  signalComputedAt DateTime?

  /// Jeu de démonstration. Obligatoire dès qu'une donnée n'est pas observée,
  /// et signalé visuellement partout où la ligne s'affiche.
  isDemo       Boolean @default(false)
  /// Rattachement de catégorie fait par règles : à confirmer par un humain.
  needsReview  Boolean @default(true)
  /// Exclusion administrateur : la page reste en base, elle ne s'affiche plus.
  excluded     Boolean @default(false)
  /// Fusion de doublons : la page pointe vers celle qui la remplace.
  mergedIntoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Recherche plein texte. Colonne générée, créée en SQL : Prisma ne sait pas
  /// déclarer une colonne calculée. Voir la migration.
  searchVector Unsupported("tsvector")?

  category    Category?        @relation(fields: [categoryId], references: [id])
  ads         Ad[]
  similarTo   SimilarityEdge[] @relation("Source")
  similarFrom SimilarityEdge[] @relation("Cible")
  watches     Watch[]

  @@index([signalScore(sort: Desc)])
  @@index([categoryId, signalScore(sort: Desc)])
  @@index([excluded, signalScore(sort: Desc)])
}

model Ad {
  id           String @id @default(cuid())
  metaAdId     String @unique
  advertiserId String

  bodyText        String?
  linkTitle       String?
  linkDescription String?
  linkCaption     String?
  landingUrl      String?
  landingDomain   String?
  /// Instantané officiel Meta. Toute annonce affichée y renvoie.
  snapshotUrl     String

  deliveryStartTime DateTime
  deliveryStopTime  DateTime?

  publisherPlatforms String[]
  languages          String[]
  reachedCountries   String[]

  firstSeenAt DateTime
  lastSeenAt  DateTime
  isActive    Boolean  @default(true)

  /// Empreinte de la création : texte d'accroche, titre, description, légende,
  /// et sommes de contrôle des visuels quand ils ont pu être copiés.
  ///
  /// C'est l'unité du « rythme de test » du signal. Elle ne repose pas sur la
  /// seule image : l'API ne rend que des vignettes basse résolution dont les
  /// URL expirent, et parfois rien du tout. Rediffuser la même création sur
  /// dix annonces n'est pas dix tests, c'est un seul — l'empreinte le dit,
  /// avec ou sans visuel.
  creativeHash String

  /// Meta l'a retirée de son archive, Nexteo la conserve. C'est l'argument de
  /// vente du produit, pas un déchet : on ne supprime jamais cette ligne.
  goneFromMeta Boolean @default(false)
  isDemo       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searchVector Unsupported("tsvector")?

  advertiser   Advertiser      @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  creatives    AdCreative[]
  observations AdObservation[]

  @@index([advertiserId, deliveryStartTime])
  @@index([advertiserId, isActive])
  @@index([advertiserId, creativeHash])
  @@index([landingDomain])
}

enum CreativeType {
  image
  video
}

model AdCreative {
  id         String       @id @default(cuid())
  adId       String
  type       CreativeType
  /// Clé dans le stockage objet. `null` tant que le fichier n'a pas été copié :
  /// stockage non configuré, téléchargement en échec, URL déjà expirée. On
  /// garde la ligne pour savoir ce qui reste à rattraper, plutôt que de faire
  /// disparaître le visuel des comptes.
  storageKey String?
  copiedAt   DateTime?
  sourceUrl  String?
  width      Int?
  height     Int?
  /// Somme de contrôle du fichier. Deux annonces qui réutilisent le même
  /// visuel partagent la même clé de stockage.
  checksum   String
  createdAt  DateTime     @default(now())

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, checksum])
  @@index([checksum])
}

/// Une ligne par annonce et par exécution du pipeline, **même quand rien n'a
/// changé**. C'est ce qui permet de calculer la continuité de diffusion, les
/// interruptions et le rythme de production de créations.
///
/// Table partitionnée par mois sur `observedAt` (voir la migration). Une clé
/// primaire d'une table partitionnée doit contenir la clé de partition, d'où
/// la clé composite.
model AdObservation {
  id         String   @default(cuid())
  adId       String
  observedAt DateTime @default(now())
  isActive   Boolean
  rawPayload Json

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([id, observedAt])
  @@index([adId, observedAt])
  @@index([observedAt])
}

// ---------------------------------------------------------------------------
// Signal et proximité
// ---------------------------------------------------------------------------

/// Poids du signal. En base pour être réglables sans déploiement ; la fonction
/// de calcul reste pure et reçoit ces valeurs en argument.
model SignalWeight {
  key       String   @id
  weight    Float
  updatedAt DateTime @updatedAt
}

model SimilarityEdge {
  advertiserId        String
  relatedAdvertiserId String
  score               Float
  /// Ce qui rapproche les deux pages : catégorie, vocabulaire d'accroche,
  /// domaine de destination. Affiché à l'utilisateur.
  reasons             Json
  computedAt          DateTime @default(now())

  advertiser Advertiser @relation("Source", fields: [advertiserId], references: [id], onDelete: Cascade)
  related    Advertiser @relation("Cible", fields: [relatedAdvertiserId], references: [id], onDelete: Cascade)

  @@id([advertiserId, relatedAdvertiserId])
  @@index([advertiserId, score(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Bibliothèque de l'utilisateur
// ---------------------------------------------------------------------------

model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SavedItem[]

  @@unique([userId, name])
}

enum SavedItemType {
  advertiser
  ad
}

model SavedItem {
  id           String        @id @default(cuid())
  userId       String
  itemType     SavedItemType
  itemId       String
  collectionId String?
  note         String?
  createdAt    DateTime      @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, itemType, itemId, collectionId])
  @@index([userId, createdAt])
}

model Watch {
  id             String    @id @default(cuid())
  userId         String
  advertiserId   String
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@unique([userId, advertiserId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

// ---------------------------------------------------------------------------
// Pipeline
// ---------------------------------------------------------------------------

enum IngestStatus {
  pending
  running
  succeeded
  failed
}

model IngestJob {
  id          String       @id @default(cuid())
  countryCode String
  searchTerm  String?
  /// Curseur de pagination Meta, persisté pour reprendre exactement où
  /// l'exécution s'est arrêtée après une interruption.
  cursor      String?
  status      IngestStatus @default(pending)
  startedAt   DateTime?
  finishedAt  DateTime?
  adsFetched  Int          @default(0)
  adsNew      Int          @default(0)
  error       String?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
  @@index([countryCode, createdAt(sort: Desc)])
}

model RateLimitState {
  key       String    @id
  remaining Int?
  resetAt   DateTime?
  updatedAt DateTime  @updatedAt
}
